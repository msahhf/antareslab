# AntaresStudio IoT - Backend
# 
# Hızlı başlatma:
#   pip install -r requirements.txt
#   uvicorn app.main:app --reload
#
# Ortam değişkenleri (.env dosyası):
#   MESHROOM_BIN=/path/to/meshroom_batch

# Çalışma ortamı
DEBUG=True
HOST=0.0.0.0
PORT=8000

# rembg model (u2net, u2netp, u2net_human_seg, silueta)
REMBG_MODEL=u2net

# Meshroom yolu (kuruluysa)
# MESHROOM_BIN=/opt/meshroom/meshroom_batch
